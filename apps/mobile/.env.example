# Firebase Console → Project settings → Your apps → Web app configuration.
# These are public client configuration values, never service-account keys.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional legacy FastAPI tools only; app accounts and tabs use Firebase.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
