# Used by the mobile app to reach the FastAPI backend.
# For iPhone/Android on the same Wi-Fi as your Mac, use your Mac LAN IP.
# Example: EXPO_PUBLIC_API_URL=http://192.168.0.199:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Copy these from your Supabase project's Connect dialog.
# Use only the publishable key here. Secret/service-role keys belong on a server.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
