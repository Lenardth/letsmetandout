{
  "name": "mobile",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "api": "cd backend && DEBUG=true PYTHONPATH=. .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev": "npx expo start --lan",
    "dev:local": "npx expo start --localhost",
    "dev:tunnel": "npx expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "firebase:check": "node scripts/check-firebase.mjs",
    "test:firebase": "node --test tests/firebaseData.test.mjs",
    "test:business": "node --test tests/business.test.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-safemeet \"node --test tests/firestoreRules.test.mjs\"",
    "test:auth": "node --test tests/authLoading.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dev": "^0.4.7",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "5.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.72.2",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "@uploadcare/upload-client": "6.14.3",
    "axios": "^1.11.0",
    "color2k": "^2.0.3",
    "date-fns": "^4.1.0",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-calendar": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-contacts": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "lodash": "^4.17.21",
    "lucide-react-native": "^0.525.0",
    "moti": "0.30.0",
    "papaparse": "^5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "https://codeload.github.com/craftworkco/react-native-calendars/tar.gz/ae19e2af74ecdb29d6117ca41fbf41977a10cc23",
